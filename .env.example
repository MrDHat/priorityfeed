# X developer app (console.x.com -> project -> app)
X_CLIENT_ID=your_client_id
X_CLIENT_SECRET=your_client_secret
X_REDIRECT_URI=http://127.0.0.1:4321/callback
X_CALLBACK_PORT=4321
# Auto-filled by `npm run dev -- login` (token JSON path, default .cache/x-tokens.json)
X_TOKEN_FILE=.cache/x-tokens.json
# TypeSafe API key (console.typesafe.ai)
TYPESAFE_API_KEY=your_typesafe_key